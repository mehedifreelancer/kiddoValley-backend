generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  email     String    @unique
  password  String
  name      String
  role      String    @default("cashier")
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  products Product[]

  attributePriority Json? @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Barcode {
  id        Int      @id @default(autoincrement())
  title     String
  barcode   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barcodes")
}

// schema.prisma - Product মডেলে attributePriority যোগ করুন
model Product {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  categoryId         Int
  category           Category @relation(fields: [categoryId], references: [id])
  description        String?
  videoUrl           String?
  thumbnail          String?
  isForceOrder       Boolean  @default(false)
  forceOrderPriority Int      @default(0)
  isPublished        Boolean  @default(false)
  attributePriority  Json?    @default("[]") // ✅ যোগ করো
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  variants     Variant[]
  suppliers    ProductSupplier[]
  manufactures Manufacture[]
}

model Variant {
  id              Int      @id @default(autoincrement())
  sku             String   @unique
  barcode         String?  @unique
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  attributes      Json
  images          Json?
  isImported      Boolean  @default(false)
  countryOfOrigin String?
  manufactureId   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stocks Stock[]

  @@map("variants")
}

model Stock {
  id                  Int      @id @default(autoincrement())
  variantId           Int
  variant             Variant  @relation(fields: [variantId], references: [id])
  batchNo             String
  buyingOrMakingPrice Float
  sellingPrice        Float
  discountPercent     Int      @default(0)
  currentQty          Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  soldItems SoldItem[]
  movements StockMovement[]

  @@map("stocks")
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  stockId     Int
  stock       Stock    @relation(fields: [stockId], references: [id])
  productId   Int
  type        String // PURCHASE, SALE, ADJUSTMENT, PRICE_CHANGE, RETURN, WASTAGE, LOST, FOUND
  quantity    Int // positive for addition, negative for removal
  reason      String?
  referenceId Int? // orderId, purchaseId, etc.
  createdAt   DateTime @default(now())
  createdBy   Int? // admin user id

  @@map("stock_movements")
}

model CustomerInfo {
  phone          String   @id @unique
  name           String
  address        String
  secondaryPhone String?
  gender         String? // 'male', 'female', 'other'
  hasBaby        Boolean? @default(false)
  preferredToy   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]
}

model Order {
  id                  Int           @id @default(autoincrement())
  invoiceNo           String        @unique
  subtotal            Float
  discount            Float
  total               Float
  customerName        String
  customerPhone       String
  customerPhone2      String?
  customerAddress     String
  deliveryDate        DateTime?
  paymentStatus       String        @default("pending")
  deliveryStatus      String?       @default("Pending") // 🆕 New field
  pathaoInvoiceId     String? // 🆕 New field
  pathaoConsignmentId String?       @unique
  pathaoLastSyncedAt  DateTime? // 🆕 New field
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  soldItems           SoldItem[]
  orderedByPhone      String? // foreign key to CustomerInfo.phone
  customerInfo        CustomerInfo? @relation(fields: [orderedByPhone], references: [phone])
}

model SoldItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id])
  productId  Int
  variantId  Int?
  stockId    Int
  stock      Stock    @relation(fields: [stockId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())

  @@map("sold_items")
}

model Supplier {
  id            Int               @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  paymentTerms  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  products      ProductSupplier[]

  @@map("suppliers")
}

model ProductSupplier {
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  price      Float?
  isPrimary  Boolean  @default(false)

  @@id([productId, supplierId])
  @@map("product_suppliers")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  type      String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SliderImage {
  id         Int      @id @default(autoincrement())
  deviceType String // 'desktop' or 'mobile'
  imageUrl   String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("slider_images")
}

model HeroSlider {
  id               Int      @id @default(autoincrement())
  badgeText        String
  firstTitle       String
  secondTitle      String
  firstTitleColor  String // Tailwind class for first title (e.g., "text-purple-600")
  secondTitleColor String // Tailwind class for second title
  description      String
  bookTitle        String
  bookSubtitle     String
  sliderDetailsUrl String?
  bgImage          String
  innerBigImage    String
  innerTopImage    String
  innerBottomImage String
  order            Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("hero_sliders")
}

model Manufacture {
  id              Int      @id @default(autoincrement())
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  variantId       Int?
  totalQuantity   Int
  costComponents  Json?
  notes           String?
  totalCost       Float
  unitCost        Float
  manufactureDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("manufactures")
}

model ProductAttribute {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_attributes")
}
