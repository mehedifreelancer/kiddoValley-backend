generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  email     String    @unique
  password  String
  name      String
  role      String    @default("cashier")
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  products Product[]

  attributePriority Json? @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Barcode {
  id        Int      @id @default(autoincrement())
  title     String
  barcode   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barcodes")
}

model Product {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  categoryId         Int
  category           Category @relation(fields: [categoryId], references: [id])
  description        String?
  videoUrl           String?
  thumbnail          String?
  isForceOrder       Boolean  @default(false)
  weight             Float? // kg
  forceOrderPriority Int      @default(0)
  isPublished        Boolean  @default(false)
  attributePriority  Json?    @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  variants     Variant[]
  suppliers    ProductSupplier[]
  manufactures Manufacture[]

  @@map("products")
}

model Variant {
  id              Int      @id @default(autoincrement())
  sku             String   @unique
  barcode         String?  @unique
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  attributes      Json
  images          Json?
  isImported      Boolean  @default(false)
  countryOfOrigin String?
  manufactureId   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stocks Stock[]

  @@map("variants")
}

model Stock {
  id                  Int      @id @default(autoincrement())
  variantId           Int
  variant             Variant  @relation(fields: [variantId], references: [id])
  batchNo             String
  buyingOrMakingPrice Float
  sellingPrice        Float
  discountPercent     Int      @default(0)
  currentQty          Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  soldItems SoldItem[]
  movements StockMovement[]

  @@map("stocks")
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  stockId     Int
  stock       Stock    @relation(fields: [stockId], references: [id])
  productId   Int
  type        String // PURCHASE, SALE, ADJUSTMENT, PRICE_CHANGE, RETURN, WASTAGE, LOST, FOUND
  quantity    Int // positive for addition, negative for removal
  reason      String?
  referenceId Int? // orderId, purchaseId, etc.
  createdAt   DateTime @default(now())
  createdBy   Int? // admin user id

  @@map("stock_movements")
}

model CustomerInfo {
  phone          String   @id @unique
  name           String
  address        String
  secondaryPhone String?
  gender         String? // 'male', 'female', 'other'
  hasBaby        Boolean? @default(false)
  preferredToy   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]

  @@map("customer_infos")
}

model Order {
  id              Int       @id @default(autoincrement())
  invoiceNo       String    @unique
  subtotal        Float
  discount        Float
  total           Float
  customerName    String
  customerPhone   String
  customerPhone2  String?
  customerAddress String
  deliveryDate    DateTime?

  orderStatus    String  @default("new") // new, confirmed, cancelled
  isWebsiteOrder Boolean @default(false)
  isSuspicious   Boolean @default(false)
  deliveryCharge Float   @default(0) // 🆕 ফ্রন্টএন্ড থেকে আসা ডেলিভারি চার্জ
  packagingCost  Float   @default(0) // 🆕 ডাটাবেস থেকে পড়া প্যাকেজিং কস্ট (শুধু রেকর্ড

  hasRefund     Boolean @default(false)
  refundStatus  String  @default("none") // "none" | "partial" | "full"
  totalRefunded Float   @default(0)

  paymentStatus       String    @default("pending")
  deliveryStatus      String?   @default("Pending")
  pathaoInvoiceId     String?
  pathaoConsignmentId String?   @unique
  pathaoLastSyncedAt  DateTime?

  soldItems      SoldItem[]
  orderedByPhone String?
  customerInfo   CustomerInfo? @relation(fields: [orderedByPhone], references: [phone])

  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model SoldItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  productName       String
  variantSku        String
  variantAttributes Json?
  unitPrice         Float
  totalPrice        Float
  quantity          Int

  refundedAmount  Float   @default(0)
  isFullyRefunded Boolean @default(false)

  productId Int?
  variantId Int?
  stockId   Int?

  createdAt DateTime @default(now())
  stock     Stock?   @relation(fields: [stockId], references: [id])

  refunds Refund[]

  @@map("sold_items")
}

model Refund {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  soldItemId Int?
  soldItem   SoldItem? @relation(fields: [soldItemId], references: [id])

  type          String // "partial" | "full"
  amount        Float
  reason        String // "defect" | "lost" | "other" | ...
  imageUrl      String? @db.Text
  transactionId String?

  createdAt DateTime @default(now())
  createdBy Int?

  @@map("refunds")
}

model Supplier {
  id            Int               @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  paymentTerms  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  products      ProductSupplier[]

  @@map("suppliers")
}

model ProductSupplier {
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  price      Float?
  isPrimary  Boolean  @default(false)

  @@id([productId, supplierId])
  @@map("product_suppliers")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SliderImage {
  id         Int      @id @default(autoincrement())
  deviceType String // 'desktop' or 'mobile'
  imageUrl   String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("slider_images")
}

model HeroSlider {
  id               Int      @id @default(autoincrement())
  badgeText        String
  firstTitle       String
  secondTitle      String
  firstTitleColor  String
  secondTitleColor String
  description      String
  bookTitle        String
  bookSubtitle     String
  sliderDetailsUrl String?
  bgImage          String
  innerBigImage    String
  innerTopImage    String
  innerBottomImage String
  order            Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("hero_sliders")
}

model Manufacture {
  id              Int      @id @default(autoincrement())
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  variantId       Int?
  totalQuantity   Int
  costComponents  Json?
  notes           String?
  totalCost       Float
  unitCost        Float
  manufactureDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("manufactures")
}

model ProductAttribute {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_attributes")
}

model DeliverySettings {
  id Int @id @default(1)

  weightTiers Json

  overweightInsideDhaka  Float @default(15)
  overweightOutsideDhaka Float @default(25)
  overweightSuburbs      Float @default(20) // 🆕

  codPercentage           Float @default(1)
  deliveryDiscountPercent Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("delivery_settings")
}

model PackagingSettings {
  id                   Int   @id @default(1)
  averagePackagingCost Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("packaging_settings")
}

model TransactionCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  type        String // 'in' বা 'out'
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]

  @@map("transaction_categories")
}

model Transaction {
  id         Int                 @id @default(autoincrement())
  date       DateTime            @default(now())
  categoryId Int
  category   TransactionCategory @relation(fields: [categoryId], references: [id])
  amount     Float
  note       String?
  createdBy  Int?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("transactions")
}

model Asset {
  id           Int      @id @default(autoincrement())
  name         String
  value        Float
  purchaseDate DateTime @default(now())
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("assets")
}

model EmployeeBill {
  id          Int      @id @default(autoincrement())
  name        String
  amount      Float
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("employee_bills")
}

model RawMaterial {
  id          Int      @id @default(autoincrement())
  name        String
  amount      Float
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("raw_materials")
}
