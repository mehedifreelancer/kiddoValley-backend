generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  email     String    @unique
  password  String
  name      String
  role      String    @default("cashier")
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Barcode {
  id        Int      @id @default(autoincrement())
  title     String
  barcode   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barcodes")
}

model Product {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  barcode            String?  @unique
  categoryId         Int
  category           Category @relation(fields: [categoryId], references: [id])
  description        String?
  videoUrl           String?
  images             Json
  isForceOrder       Boolean  @default(false)
  forceOrderPriority Int      @default(0)
  isPublished        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  variants     Variant[]
  suppliers    ProductSupplier[]
  manufactures Manufacture[] // relation to Manufacture

  @@map("products")
}

model Variant {
  id              Int      @id @default(autoincrement())
  sku             String   @unique
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  attributes      Json // e.g., { "color": "Red" }
  images          Json? // up to 3 images
  isImported      Boolean  @default(false)
  countryOfOrigin String?
  manufactureId   Int? // optional link to Manufacture
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stocks Stock[] // all batches of this variant

  @@map("variants")
}

model Stock {
  id                  Int      @id @default(autoincrement())
  variantId           Int
  variant             Variant  @relation(fields: [variantId], references: [id])
  batchNo             String
  buyingOrMakingPrice Float
  sellingPrice        Float
  discountPercent     Int      @default(0)
  currentQty          Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  soldItems SoldItem[]
  movements StockMovement[]

  @@map("stocks")
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  stockId     Int
  stock       Stock    @relation(fields: [stockId], references: [id])
  productId   Int // denormalized for faster queries
  type        String // PURCHASE, SALE, ADJUSTMENT, PRICE_CHANGE
  quantity    Int // positive = add, negative = remove
  reason      String?
  referenceId Int? // saleId or other reference
  createdAt   DateTime @default(now())
  createdBy   Int?

  @@map("stock_movements")
}

model Sale {
  id            Int      @id @default(autoincrement())
  invoiceNo     String   @unique
  subtotal      Float
  tax           Float?
  discount      Float?
  total         Float
  paymentMode   String?
  paymentStatus String   @default("paid")
  customerName  String?
  customerPhone String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items SoldItem[]

  @@map("sales")
}

model SoldItem {
  id         Int      @id @default(autoincrement())
  saleId     Int
  sale       Sale     @relation(fields: [saleId], references: [id])
  productId  Int
  variantId  Int? // optional for reporting
  stockId    Int
  stock      Stock    @relation(fields: [stockId], references: [id])
  quantity   Int
  unitPrice  Float // selling price at the time of sale
  totalPrice Float
  createdAt  DateTime @default(now())

  @@map("sold_items")
}

model Supplier {
  id            Int               @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  paymentTerms  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  products      ProductSupplier[]

  @@map("suppliers")
}

model ProductSupplier {
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  price      Float?
  isPrimary  Boolean  @default(false)

  @@id([productId, supplierId])
  @@map("product_suppliers")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  type      String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Manufacture {
  id              Int      @id @default(autoincrement())
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  variantId       Int? // which variant this manufacture produced
  totalQuantity   Int
  costComponents  Json? // breakdown of costs
  notes           String?
  totalCost       Float
  unitCost        Float
  manufactureDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("manufactures")
}

model ProductAttribute {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_attributes")
}
