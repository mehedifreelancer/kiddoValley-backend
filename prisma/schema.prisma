generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  email     String    @unique
  password  String
  name      String
  role      String    @default("cashier")
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Barcode {
  id        Int      @id @default(autoincrement())
  title     String
  barcode   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barcodes")
}

model Product {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  categoryId         Int
  category           Category @relation(fields: [categoryId], references: [id])
  description        String?
  videoUrl           String?
  images             Json
  isForceOrder       Boolean  @default(false)
  forceOrderPriority Int      @default(0)
  isPublished        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  variants     Variant[]
  suppliers    ProductSupplier[]
  manufactures Manufacture[]

  @@map("products")
}

model Variant {
  id              Int      @id @default(autoincrement())
  sku             String   @unique
  barcode         String?  @unique
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  attributes      Json
  images          Json?
  isImported      Boolean  @default(false)
  countryOfOrigin String?
  manufactureId   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stocks Stock[]

  @@map("variants")
}

model Stock {
  id                  Int      @id @default(autoincrement())
  variantId           Int
  variant             Variant  @relation(fields: [variantId], references: [id])
  batchNo             String
  buyingOrMakingPrice Float
  sellingPrice        Float
  discountPercent     Int      @default(0)
  currentQty          Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  soldItems SoldItem[]
  movements StockMovement[]

  @@map("stocks")
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  stockId     Int
  stock       Stock    @relation(fields: [stockId], references: [id])
  productId   Int
  type        String // PURCHASE, SALE, ADJUSTMENT, PRICE_CHANGE, RETURN, WASTAGE, LOST, FOUND
  quantity    Int // positive for addition, negative for removal
  reason      String?
  referenceId Int? // orderId, purchaseId, etc.
  createdAt   DateTime @default(now())
  createdBy   Int? // admin user id

  @@map("stock_movements")
}

model Order {
  id              Int       @id @default(autoincrement())
  invoiceNo       String    @unique
  subtotal        Float
  tax             Float?
  discount        Float?
  total           Float
  paymentMode     String?
  paymentStatus   String    @default("paid")
  customerName    String?
  customerPhone   String?
  customerPhone2  String?
  customerAddress String?
  deliveryDate    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items SoldItem[]
}

model SoldItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id])
  productId  Int
  variantId  Int?
  stockId    Int
  stock      Stock    @relation(fields: [stockId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())

  @@map("sold_items")
}

model Supplier {
  id            Int               @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  paymentTerms  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  products      ProductSupplier[]

  @@map("suppliers")
}

model ProductSupplier {
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  price      Float?
  isPrimary  Boolean  @default(false)

  @@id([productId, supplierId])
  @@map("product_suppliers")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  type      String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Manufacture {
  id              Int      @id @default(autoincrement())
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  variantId       Int?
  totalQuantity   Int
  costComponents  Json?
  notes           String?
  totalCost       Float
  unitCost        Float
  manufactureDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("manufactures")
}

model ProductAttribute {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_attributes")
}
